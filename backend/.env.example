# Configuración de base de datos para UMAD Progress
# SQLite (por defecto):
DATABASE_URL=sqlite:///./umad_progress.db

# Ejemplo PostgreSQL:
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/umad_progress

# Ejemplo MySQL:
# DATABASE_URL=mysql+pymysql://usuario:contraseña@localhost:3306/umad_progress
